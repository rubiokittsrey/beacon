# byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# virtual environment (uv.lock is tracked on purpose)
.venv/

# environment variables file (if you use one)
.env

# ide files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# logs (a per-run directory each start)
logs/
*.log

# sqlite databases, including the default storage path, plus WAL sidecars
*.db
*.db-wal
*.db-shm

# build / distribution directories
build/
dist/
*.egg-info/
.eggs/

# tool caches / coverage
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
